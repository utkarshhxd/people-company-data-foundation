.env

# Database dumps. They contain everything the database does, which is every
# vendor's personal data plus its provenance -- a backup is the single most
# concentrated copy of it that exists.
backups/
*.dump

# Real vendor exports used to exercise the pipeline at production scale.
# Never committed: they are ~184 MB and contain real personal data (consumer
# names, home addresses, phone numbers, email addresses, IP addresses).
testfiles/

# Credential files for the docker-compose.secrets.yml overlay. The whole point
# of that overlay is that these never enter the image, the environment, or here.
secrets/

# Local ingestion drop dir. Everything in it is ignored by default, because
# anything cut from testfiles/ -- samples/, scaled/, full/, corpus/ -- carries
# the same real personal data the originals do.
#
# The one exception is data/inbox/fixtures/, which is hand-written synthetic
# data: no real person is in it, and the pipeline's documented walkthroughs
# depend on those exact rows. Adding a fixture means dropping it in that
# directory; nothing else needs an entry here any more.
data/inbox/*
!data/inbox/fixtures/
# The watched drop directories. The feed.json in each is configuration and is
# committed; anything dropped alongside one is vendor data and is not.
!data/inbox/watch/
data/inbox/watch/*/*
!data/inbox/watch/*/feed.json
!data/inbox/watch/README.md

# Terraform working state. .tfstate can contain resource attributes the
# provider treats as sensitive (e.g. connection strings); it belongs in the
# remote backend (see deploy/azure/terraform/README.md), never in git.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.auto.tfvars

# The kubeconfig copied off the master by the `kubeconfig_command` Terraform
# output. It carries client-certificate-data and client-key-data -- full
# cluster-admin credentials, not a pointer to them. Fetch it again rather
# than keeping it anywhere it could be pushed.
kubeconfig
kubeconfig.yaml

.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
.idea/
.vscode/
Thumbs.db
.DS_Store
*.vsix
