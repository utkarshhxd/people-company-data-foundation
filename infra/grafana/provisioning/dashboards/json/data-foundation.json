{
  "title": "Data Foundation",
  "uid": "pcdf-data-foundation",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Human review backlogs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Quarantined, awaiting review",
      "description": "Records held back from entity resolution. They are fully stored and lose nothing by waiting — but nothing ages this queue automatically, so only this panel will tell you it is growing.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(pcdf_quarantine_items{status=\"open\"})", "refId": "A", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 1, "color": "yellow" },
            { "value": 25, "color": "red" }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Mappings needing review",
      "description": "Columns whose meaning is still a guess. Until reviewed, their values are captured but attributed to no canonical field, so they cannot be validated or resolved on.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 5, "y": 1 },
      "targets": [{ "expr": "sum(pcdf_column_mappings{status=\"needs_review\"})", "refId": "A", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 1, "color": "yellow" },
            { "value": 20, "color": "red" }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Matches awaiting a decision",
      "description": "While one of these waits, a single real-world entity is represented by two ids.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 10, "y": 1 },
      "targets": [{ "expr": "sum(pcdf_match_candidates{status=\"open\"}) or vector(0)", "refId": "A", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 1, "color": "yellow" },
            { "value": 20, "color": "red" }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Oldest item waiting",
      "description": "How long the longest-waiting review has been open. A rising line here means the queues are not being worked, which no count alone would reveal.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 1 },
      "targets": [
        { "expr": "pcdf_oldest_open_quarantine_age_seconds", "refId": "A", "legendFormat": "quarantine" },
        { "expr": "pcdf_oldest_unreviewed_mapping_age_seconds", "refId": "B", "legendFormat": "mapping review" },
        { "expr": "pcdf_oldest_open_match_candidate_age_seconds", "refId": "C", "legendFormat": "match decision" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 8, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Data quality",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "title": "Records by validation status",
      "description": "'invalid' means not safe to resolve yet, never deleted. Every one of these records is still fully stored.",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 7, "x": 0, "y": 8 },
      "targets": [{ "expr": "pcdf_records_validated", "refId": "A", "legendFormat": "{{status}}", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "valid" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "warning" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "invalid" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "id": 6,
      "title": "Validation failures by severity",
      "description": "Warnings are expected in real vendor data and never quarantine a record; only errors do.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 10, "x": 7, "y": 8 },
      "targets": [{ "expr": "pcdf_validation_failures", "refId": "A", "legendFormat": "{{severity}}" }],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "warning" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      }
    },
    {
      "id": 7,
      "title": "Values captured but unattributed",
      "description": "Observations with no confirmed canonical field. Nothing is lost — the raw value is stored — but these cannot be used until the mapping is reviewed.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 7, "x": 17, "y": 8 },
      "targets": [
        { "expr": "pcdf_observations_uncanonical", "refId": "A", "instant": true, "legendFormat": "unattributed" },
        { "expr": "pcdf_attribute_observations", "refId": "B", "instant": true, "legendFormat": "total observations" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Trusted data",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "Entities",
      "description": "Merged entities are tombstones, never deleted — any id ever handed out still resolves.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 7, "x": 0, "y": 16 },
      "targets": [{ "expr": "pcdf_entities", "refId": "A", "legendFormat": "{{entity_type}} / {{status}}", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-BlPu" } }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Mean golden confidence",
      "description": "Confidence IN THE CHOSEN VALUE — distinct from mapping confidence, validation result, match confidence and source reliability, which are never folded together.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 7, "x": 7, "y": 16 },
      "targets": [{ "expr": "pcdf_golden_mean_confidence", "refId": "A", "legendFormat": "{{entity_type}}", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1, "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "red" },
            { "value": 0.5, "color": "yellow" },
            { "value": 0.75, "color": "green" }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Golden values",
      "description": "Contested = sources disagreed. Not an error, but the fields most worth a human's attention.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 10, "x": 14, "y": 16 },
      "targets": [
        { "expr": "sum(pcdf_golden_values{state=\"current\"})", "refId": "A", "instant": true, "legendFormat": "current" },
        { "expr": "sum(pcdf_golden_values{state=\"superseded\"}) or vector(0)", "refId": "B", "instant": true, "legendFormat": "superseded" },
        { "expr": "pcdf_golden_contested_values", "refId": "C", "instant": true, "legendFormat": "contested" },
        { "expr": "pcdf_golden_low_confidence_values", "refId": "D", "instant": true, "legendFormat": "low confidence" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "value_and_name", "orientation": "horizontal" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "contested" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "low confidence" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Pipeline integrity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "title": "Metrics reachable",
      "description": "0 means the gauges could not be read from Postgres. The scrape still succeeds — monitoring that dies with the database is useless exactly when it is needed.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "targets": [{ "expr": "pcdf_metrics_up", "refId": "A", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "STALE", "color": "red" }, "1": { "text": "OK", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Batches with unpublished events",
      "description": "Rows were committed to Postgres but their Kafka events never published. Postgres is the source of truth, so this is a visible gap to replay — not data loss.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 24 },
      "targets": [{ "expr": "pcdf_batches_events_unpublished", "refId": "A", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "red" }] }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Records awaiting resolution",
      "description": "Passed validation but not yet linked to an entity. A persistently non-zero value means the resolution consumer is stalled, or records were released from quarantine and need a re-run.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 24 },
      "targets": [{ "expr": "pcdf_records_awaiting_resolution", "refId": "A", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "yellow" }] }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Volume",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 24 },
      "targets": [
        { "expr": "pcdf_raw_records", "refId": "A", "instant": true, "legendFormat": "raw records" },
        { "expr": "sum(pcdf_batches)", "refId": "B", "instant": true, "legendFormat": "batches" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "value_and_name", "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    }
  ]
}
