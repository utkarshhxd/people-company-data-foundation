POSTGRES_USER=pcdf_dev
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=pcdf
POSTGRES_PORT=5433

KAFKA_PORT=29092

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_dev_only
# 3000 is the port every Node dev server also wants. If one is already running,
# Docker Desktop can leave the container up and healthy but unreachable from the
# host rather than failing loudly — so pick a free port here instead.
GRAFANA_PORT=3001

PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

API_PORT=8000

# API authentication.
#
# Set PCDF_API_KEYS to a comma-separated list and every /entities and /records
# route requires one, via `X-API-Key:` or `Authorization: Bearer`. Health checks
# and /metrics stay open, because a liveness probe that needs a credential
# reports the credential's health rather than the service's.
#
# With no keys set, the API refuses any request that did not come from loopback.
# Requests from the host arrive via the Docker bridge and are NOT loopback, so
# local development opts out below. Remove that line before this is reachable by
# anything else: what it serves is personal data with provenance attached.
PCDF_API_KEYS=
PCDF_ALLOW_UNAUTHENTICATED=true

# Any setting here can be supplied as a file instead, either by naming one
# (POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password) or by mounting it at
# /run/secrets/<lowercase_name>, which is found without being configured. A
# variable always beats a file, so nothing here changes behaviour by existing.
#
# docker-compose.secrets.yml wires all of that up for POSTGRES_PASSWORD and
# PCDF_API_KEYS in one step:
#
#   mkdir -p secrets
#   printf '%s' 'a-strong-password' > secrets/postgres_password
#   printf '%s' 'key-one,key-two'   > secrets/pcdf_api_keys
#   docker compose -f docker-compose.yml -f docker-compose.secrets.yml up -d

# Where firing alerts go. Unset means nowhere: they collect in Alertmanager's
# own UI at :9093 and nothing leaves this machine. Set it to an incoming webhook
# (Slack, Teams and Discord all take this shape) and every alert is delivered.
# The value is a credential -- anyone holding it can post into that channel --
# so it is written to a file only Alertmanager can read, never into its config.
ALERTMANAGER_WEBHOOK_URL=

LOG_LEVEL=info
