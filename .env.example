POSTGRES_USER=pcdf_dev
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=pcdf
POSTGRES_PORT=5433

# Any setting here can be supplied as a file instead, either by naming one
# (POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password) or by mounting it at
# /run/secrets/<lowercase_name>, which is found without being configured. A
# variable always beats a file, so nothing here changes behaviour by existing.
#
# docker-compose.secrets.yml wires that up for POSTGRES_PASSWORD in one step:
#
#   mkdir -p secrets
#   printf '%s' 'a-strong-password' > secrets/postgres_password
#   docker compose -f docker-compose.yml -f docker-compose.secrets.yml up -d

# debug, info, warning, error or critical. Read by every service and by the
# review console; an unrecognised value logs a complaint and falls back to
# info rather than refusing to start.
LOG_LEVEL=info

# Bounded waits on every database connection. A Postgres that accepts the
# connection and then stops answering would otherwise hold a caller forever --
# and in the console, "forever" is a request worker that never serves anyone
# again. Raise the statement timeout if a legitimate query is being killed;
# migrations already run with no limit at all, since building an index over a
# large table is a legitimately long statement.
#   CONNECT_TIMEOUT_SECONDS=10
#   STATEMENT_TIMEOUT_MS=300000

# How long the watcher may go without finishing a sweep before its Docker
# healthcheck calls it stuck. It also beats after each individual file, so
# this bounds one file, not a backlog.
#   PCDF_WATCH_STALE_AFTER=1800

# AI assistance, both opt-in and both backed by a local Ollama model -- nothing
# here calls a cloud API. Bring the model up only for the window you need it:
#   docker compose --profile ai up -d ollama
#   docker compose exec ollama ollama pull gemma3:4b
#   ...run mapping/pipeline/enrichment...
#   docker compose stop ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_PORT=11434

# Off by default: turning this on makes schema mapping (which runs inline on
# every file load) call Ollama for any column the deterministic rules leave
# below auto-accept. Only turn it on while `ollama` is actually running.
AI_MAPPING_ENABLED=false

# Reliability of the synthetic 'ai_enrichment' source the enrichment batch job
# writes through. Kept below every real vendor's default (0.50) on purpose: an
# AI guess should only ever win a field that has no other reported value.
AI_ENRICHMENT_RELIABILITY=0.20

# The review console (http://localhost:8000/review/page) shows personal data
# with full provenance. Empty and unset here means it serves only to loopback;
# set one to open it up beyond that -- see services/review_console.
#   PCDF_API_KEYS=a-long-random-string,a-second-one-for-rotation
#   PCDF_ALLOW_UNAUTHENTICATED=true   # deliberately open, no keys checked
PCDF_API_KEYS=
PCDF_ALLOW_UNAUTHENTICATED=
REVIEW_CONSOLE_PORT=8000
