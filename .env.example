POSTGRES_USER=pcdf_dev
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=pcdf
POSTGRES_PORT=5433

# Any setting here can be supplied as a file instead, either by naming one
# (POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password) or by mounting it at
# /run/secrets/<lowercase_name>, which is found without being configured. A
# variable always beats a file, so nothing here changes behaviour by existing.
#
# docker-compose.secrets.yml wires that up for POSTGRES_PASSWORD in one step:
#
#   mkdir -p secrets
#   printf '%s' 'a-strong-password' > secrets/postgres_password
#   docker compose -f docker-compose.yml -f docker-compose.secrets.yml up -d

# The broker. A batch is announced on it once its rows are committed, and the
# five stage consumers work from that announcement -- so a stopped stage means
# its work waits in a topic rather than being lost. Postgres stays the source
# of truth; events carry references to committed rows, never values.
KAFKA_PORT=29092

# How stale a consumer's heartbeat may get before its healthcheck calls it
# stuck. Lower than the watcher's, because a consumer handles one batch at a
# time rather than a whole file.
PCDF_CONSUMER_STALE_AFTER=900

# Grafana's own login. No default: an unset admin password is how a dashboard
# ends up on the internet with admin/admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Where a firing alert goes. Unset means alerts collect in Alertmanager's own
# UI at :9093 and nothing leaves this machine -- a destination is something
# somebody has to own. Slack, Teams and Discord all take a URL of this shape.
# ALERTMANAGER_WEBHOOK_URL=https://hooks.slack.com/services/...

# Validation stops itself when almost everything coming through is invalid --
# a changed vendor format, a wrong mapping, a rule that tightened. Nothing is
# lost either way; the point is not to spend the night quarantining a whole
# feed one record at a time before anyone looks. Resume with:
#   docker compose run --rm validation validation-control resume --reviewed-by you
VALIDATION_BREAKER_ENABLED=true
VALIDATION_BREAKER_THRESHOLD=0.95
VALIDATION_BREAKER_MIN_RECORDS=100

# debug, info, warning, error or critical. Read by every service and by the
# review console; an unrecognised value logs a complaint and falls back to
# info rather than refusing to start.
LOG_LEVEL=info

# Copy WARNING and above into the `service_log` table as well as stdout, so the
# console's Activity tab can show what a service said without host access to
# eleven containers' logs. Never load-bearing: rows are dropped rather than
# blocking the service if Postgres cannot keep up, the table is trimmed to a
# fixed size, and container stdout is unaffected and remains complete. Set on
# the long-running services in docker-compose.yml; off for CLI runs, which have
# no console watching them.
#   LOG_TO_DATABASE=false
#   LOG_DATABASE_MAX_ROWS=20000

# Ingestion stops itself when a service that would process the work has gone
# away -- a consumer, or the watcher, or the broker. Nothing already in the
# system is discarded: records in flight finish, queued files are held rather
# than failed, and backlogs wait in their topics. What stops is the pile
# growing while nobody is watching.
#
# This one stop clears itself, unlike a person's pause or the validation
# breaker's: those are judgements about the data and need somebody to decide
# the reason is gone, while this is a reflex to a process not being there, and
# the same observation says when it is over. It will never undo a pause it did
# not set. Set SUPERVISOR_AUTO_RESUME=false to require a human either way.
#   SUPERVISOR_ENABLED=true
#   SUPERVISOR_INTERVAL_SECONDS=30
#   SUPERVISOR_STALE_AFTER_SECONDS=180
#   SUPERVISOR_AUTO_RESUME=true
#   SUPERVISOR_HEALTHY_CHECKS_BEFORE_RESUME=3

# Bounded waits on every database connection. A Postgres that accepts the
# connection and then stops answering would otherwise hold a caller forever --
# and in the console, "forever" is a request worker that never serves anyone
# again. Raise the statement timeout if a legitimate query is being killed;
# migrations already run with no limit at all, since building an index over a
# large table is a legitimately long statement.
#   CONNECT_TIMEOUT_SECONDS=10
#   STATEMENT_TIMEOUT_MS=300000

# How long the watcher may go without finishing a sweep before its Docker
# healthcheck calls it stuck. It also beats after each individual file, so
# this bounds one file, not a backlog.
#   PCDF_WATCH_STALE_AFTER=1800

# AI assistance, both opt-in and both backed by a local Ollama model -- nothing
# here calls a cloud API. Bring the model up only for the window you need it:
#   docker compose --profile ai up -d ollama
#   docker compose exec ollama ollama pull gemma3:4b
#   ...run mapping/pipeline/enrichment...
#   docker compose stop ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_PORT=11434

# Off by default: turning this on makes schema mapping (which runs inline on
# every file load) call Ollama for any column the deterministic rules leave
# below auto-accept. Only turn it on while `ollama` is actually running.
AI_MAPPING_ENABLED=false

# Reliability of the synthetic 'ai_enrichment' source the enrichment batch job
# writes through. Kept below every real vendor's default (0.50) on purpose: an
# AI guess should only ever win a field that has no other reported value.
AI_ENRICHMENT_RELIABILITY=0.20

# The review console (http://localhost:8000/review/page) shows personal data
# with full provenance. Empty and unset here means it serves only to loopback;
# set one to open it up beyond that -- see services/review_console.
#   PCDF_API_KEYS=a-long-random-string,a-second-one-for-rotation
#   PCDF_ALLOW_UNAUTHENTICATED=true   # deliberately open, no keys checked
PCDF_API_KEYS=
PCDF_ALLOW_UNAUTHENTICATED=
REVIEW_CONSOLE_PORT=8000
